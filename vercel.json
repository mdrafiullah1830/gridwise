{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30 }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/scenarios",
      "dest": "/api/index.py"
    },
    {
      "src": "/templates",
      "dest": "/api/index.py"
    },
    {
      "src": "/optimize-energy",
      "dest": "/api/index.py"
    },
    {
      "src": "/optimize-energy/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/compare",
      "dest": "/api/index.py"
    },
    {
      "src": "/what-if",
      "dest": "/api/index.py"
    },
    {
      "src": "/optimize-carbon",
      "dest": "/api/index.py"
    },
    {
      "src": "/history/trend",
      "dest": "/api/index.py"
    },
    {
      "src": "/history",
      "dest": "/api/index.py"
    },
    {
      "src": "/history/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/carbon/stats",
      "dest": "/api/index.py"
    },
    {
      "src": "/report",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*\\.(html|js|css|png|jpg|svg|ico|json))",
      "dest": "/public/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    }
  ]
}
